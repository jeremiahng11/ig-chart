# --- IG credentials (required unless MOCK=1) ---
IG_API_KEY=your_api_key
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password
# DEMO or LIVE
IG_ENV=DEMO
# Optional: pick a specific account (otherwise IG's default account is used)
IG_ACCOUNT_ID=

# --- Default watchlist (optional) ---
# Leave blank to auto-discover "Spot Gold" and "Bitcoin" via /markets search.
GOLD_EPIC=
BTC_EPIC=

# --- Web app ---
PORT=3000
# Strongly recommended if you deploy publicly (e.g. Railway): protects the page with basic auth
APP_USER=admin
APP_PASSWORD=

# Set to 1 to run with simulated prices (no IG account needed)
MOCK=0

# --- News, calendar and web push (optional) ---
# Economic calendar JSON (ForexFactory weekly export format)
CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# Comma-separated RSS 2.0 / Atom feeds for /api/news
NEWS_FEEDS=https://www.fxstreet.com/rss/news,https://www.investing.com/rss/news_11.rss,https://www.coindesk.com/arc/outboundfeeds/rss/
# Contact for push services (VAPID "sub" claim): mailto: or https: URL. Keys are generated into .data/vapid.json.
VAPID_SUBJECT=mailto:you@example.com

# MT5 bridge token for the IGChartsBridge EA (optional; generated and stored in .data/mt5.json when empty)
MT5_BRIDGE_TOKEN=

# Extended history: recent bars from IG, older bars from free sources (Bitstamp for crypto, Dukascopy for gold/silver/FX)
HISTORY_EXT=1
HISTORY_PROVIDERS=bitstamp,dukascopy
HISTORY_IG_DAYS=1
HISTORY_PREFETCH=Spot Gold,Bitcoin

# Alert delivery to Telegram (create a bot with @BotFather; chat id from https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert delivery by e-mail (port 465 = TLS, 587 = STARTTLS). For Gmail use an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=

# IG order placement from the app (IG Trading tab). Off unless set. Every order needs a confirm in the app.
IG_TRADING=0
# Extra switch required when IG_ENV=LIVE (real money)
IG_TRADING_LIVE=0
