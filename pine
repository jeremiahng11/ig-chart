          + ',"tma_upper":' + str.tostring(math.round(tma_upper, 2))
          + ',"buy_thresh":' + str.tostring(math.round(tad_buy_thresh, 2))
          + ',"sell_thresh":' + str.tostring(math.round(tad_sell_thresh, 2))
          + ',"tl_score":' + str.tostring(_tl_score_val)
          + ',"sym_mode":"' + _sym_mode_str + '"'
          + ',"htf":"' + _htf_str + '"'
          + ',"projection":"' + proj_dir + '"'
          + ',"do_nothing":' + str.tostring(_do_nothing_active ? 1 : 0)
          + ',"dn_reason":"' + _do_nothing_reason + '"'
          + ',"dn_watch":"'  + _do_nothing_watch  + '"'

// ── TRACK PREVIOUS STATE for change detection ─────────────
var string _prev_bias_dir = ""
var string _prev_proj_dir = ""

// ── SIGNAL ALERTS ─────────────────────────────────────────
if tmn_bull_signal and tmn_cool
    alert('{"signal":"TMN+",' + _j_common + '}', alert.freq_once_per_bar_close)

if tmn_bear_signal and tmn_cool
    alert('{"signal":"TMN-",' + _j_common + '}', alert.freq_once_per_bar_close)

if not na(confirm_lbl) and confirm_dir == 1
    alert('{"signal":"BUY",' + _j_common + '}', alert.freq_once_per_bar_close)

if not na(confirm_lbl) and confirm_dir == -1
    alert('{"signal":"SELL",' + _j_common + '}', alert.freq_once_per_bar_close)

if ready_fired and last_peak_dir == -1
    alert('{"signal":"TMN+ Watch",' + _j_common + '}', alert.freq_once_per_bar_close)

if ready_fired and last_peak_dir == 1
    alert('{"signal":"TMN- Watch",' + _j_common + '}', alert.freq_once_per_bar_close)

// ── BIAS CHANGE ALERTS ────────────────────────────────────
if barstate.isconfirmed
    if _bias_dir_str != _prev_bias_dir and _prev_bias_dir != ""
        alert('{"signal":"BIAS CHANGE","prev_bias":"' + _prev_bias_dir + '",' + _j_common + '}', alert.freq_once_per_bar_close)
    _prev_bias_dir := _bias_dir_str

// ── PROJECTION CHANGE ALERTS ──────────────────────────────
if barstate.isconfirmed
    if proj_dir != _prev_proj_dir and _prev_proj_dir != ""
        alert('{"signal":"PROJ CHANGE","prev_proj":"' + _prev_proj_dir + '",' + _j_common + '}', alert.freq_once_per_bar_close)
    _prev_proj_dir := proj_dir

// ── DO NOTHING CHANGE ALERTS ──────────────────────────────
var bool _prev_do_nothing = false
if barstate.isconfirmed
    if _do_nothing_active != _prev_do_nothing
        alert('{"signal":"DO NOTHING",' + _j_common + '}', alert.freq_once_per_bar_close)
    _prev_do_nothing := _do_nothing_active

// ── STMN ON ALERTS (early warning before TMN fires) ───────
// Only alert when STMN turns ON — not OFF
// stmn_bear = price entered sell zone (above sell threshold)
// stmn_bull = price entered buy zone (below buy threshold)
var bool _prev_stmn_bear = false
var bool _prev_stmn_bull = false
if barstate.isconfirmed
    if stmn_bear and not _prev_stmn_bear
        alert('{"signal":"STMN-","zone":"ABOVE SELL THRESHOLD",' + _j_common + '}', alert.freq_once_per_bar_close)
    if stmn_bull and not _prev_stmn_bull
        alert('{"signal":"STMN+","zone":"BELOW BUY THRESHOLD",' + _j_common + '}', alert.freq_once_per_bar_close)
    _prev_stmn_bear := stmn_bear
    _prev_stmn_bull := stmn_bull
